# ---- Production environment template ----
# Copy to .env.production (git-ignored) and fill every value. Never commit the filled file.
# Generate secrets:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"                               # JWT_SECRET, POSTGRES_PASSWORD
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  # ENCRYPTION_KEY
# The server refuses to start in production with a weak JWT_SECRET, a missing/invalid ENCRYPTION_KEY or SQLite.

ENVIRONMENT=production
LOG_LEVEL=INFO

# Sarvam AI — production key from https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_REASONING_EFFORT=low

# Database — used by docker-compose.prod.yml to build DATABASE_URL for the backend
POSTGRES_PASSWORD=
# Only set DATABASE_URL yourself when using a managed database (RDS, Cloud SQL, Neon …):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/voicecare

# Security
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=120

# Your dashboard's public HTTPS origin(s), JSON list. The microphone requires HTTPS.
CORS_ORIGINS=["https://app.example.com"]

# No demo businesses in production. Create the first admin once with:
#   docker compose ... exec backend python -m app.bootstrap --email you@yourcompany.com
SEED_DEMO_DATA=false

# Email alerts to each business's admins (new leads, handoffs). Off while SMTP_HOST is empty.
# Zoho Mail: SMTP_HOST=smtp.zoho.in, SMTP_PORT=587, SMTP_SECURITY=starttls, app-specific password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PUBLIC_BASE_URL=
