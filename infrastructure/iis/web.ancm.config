<?xml version="1.0" encoding="utf-8"?>
<!-- Alternative to web.config for hosts where HttpPlatformHandler completes the WebSocket handshake but passes
     no frames (voice calls drop with code 1006). The ASP.NET Core Module (installed wherever ASP.NET Core sites
     are hosted) starts the same bundled Python out-of-process and proxies HTTP and WebSockets to it.
     To use: rename this file to web.config in the site root (keep the old one as web.config.bak), then Recycle.
     serve.py reads the port from ASPNETCORE_PORT. -->
<configuration>
  <system.webServer>
    <webSocket enabled="true" />
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>
    <aspNetCore processPath=".\python\python.exe"
                arguments="-m serve"
                hostingModel="OutOfProcess"
                startupTimeLimit="120"
                requestTimeout="01:00:00"
                stdoutLogEnabled="true"
                stdoutLogFile=".\App_Data\logs\ancm">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </aspNetCore>
    <rewrite>
      <rules>
        <!-- The microphone only works over HTTPS, so send http:// visitors to https://.
             302 (not 301) so browsers don't cache it; /.well-known stays reachable for certificate checks. -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Found" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Defence in depth: these never leave the server even if a handler is misconfigured. -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="python" />
          <add segment="app" />
          <add segment="migrations" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
