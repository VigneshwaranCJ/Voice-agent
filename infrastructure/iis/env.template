# Settings for the Windows/IIS bundle. build-bundle.ps1 copies this to .env in the bundle and fills in
# JWT_SECRET and ENCRYPTION_KEY with fresh random values. Fill in the blanks before uploading.
# Never commit the filled-in file.

ENVIRONMENT=production
LOG_LEVEL=INFO

# One process, SQLite file inside App_Data (IIS never serves that folder). Back this file up.
DATABASE_URL=sqlite+aiosqlite:///./App_Data/kural.db
ALLOW_SQLITE_IN_PRODUCTION=true

# The built dashboard, served by the same process.
FRONTEND_DIR=./static

# Sarvam AI key from https://dashboard.sarvam.ai (voice and AI replies are off without it)
SARVAM_API_KEY=

# Security (filled in by build-bundle.ps1)
JWT_SECRET=__GENERATED__
JWT_EXPIRE_MINUTES=480
ENCRYPTION_KEY=__GENERATED__
RATE_LIMIT_PER_MINUTE=120

# Your site's public origin(s), JSON list. The microphone needs HTTPS.
CORS_ORIGINS=["https://kuralai.com"]

SEED_DEMO_DATA=false

# Platform admins, created on start if they don't exist yet (passwords: 12+ characters).
# Add more as numbered pairs: BOOTSTRAP_ADMIN_EMAIL_2 / BOOTSTRAP_ADMIN_PASSWORD_2, up to _10.
# Remove each password once that admin has signed in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
