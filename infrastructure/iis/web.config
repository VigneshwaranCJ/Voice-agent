<?xml version="1.0" encoding="utf-8"?>
<!-- IIS config for the all-in-one Windows bundle built by build-bundle.ps1.
     HttpPlatformHandler starts the bundled Python (python\python.exe -m serve) and forwards every request,
     including WebSockets, to it. IIS itself serves no files from this folder. -->
<configuration>
  <system.webServer>
    <!-- Voice calls are WebSockets. Without this, some hosts complete the handshake but never pass frames,
         so calls end immediately. Requires the IIS "WebSocket Protocol" feature on the server. -->
    <webSocket enabled="true" />
    <handlers>
      <add name="httpPlatformHandler" path="*" verb="*" modules="httpPlatformHandler" resourceType="Unspecified" />
    </handlers>
    <httpPlatform processPath=".\python\python.exe"
                  arguments="-m serve"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="01:00:00"
                  processesPerApplication="1"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\App_Data\logs\python">
      <environmentVariables>
        <environmentVariable name="PYTHONUNBUFFERED" value="1" />
        <environmentVariable name="PYTHONIOENCODING" value="utf-8" />
      </environmentVariables>
    </httpPlatform>
    <rewrite>
      <rules>
        <!-- The microphone only works over HTTPS, so send http:// visitors to https://.
             302 (not 301) so browsers don't cache it; /.well-known stays reachable for certificate checks. -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{REQUEST_URI}" pattern="^/\.well-known/" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Found" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Defence in depth: these never leave the server even if a handler is misconfigured. -->
        <hiddenSegments>
          <add segment=".env" />
          <add segment="python" />
          <add segment="app" />
          <add segment="migrations" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
