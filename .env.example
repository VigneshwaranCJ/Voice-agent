# ---- Copy to .env and fill in. Never commit .env. ----
ENVIRONMENT=development
LOG_LEVEL=INFO

# Sarvam AI (https://dashboard.sarvam.ai) — required for speech + AI replies
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_LLM_MODEL=sarvam-105b-conversations
SARVAM_LLM_REASONING_EFFORT=low

# Database: SQLite works for local dev; docker-compose uses PostgreSQL (pgvector image)
DATABASE_URL=sqlite+aiosqlite:///./voicecare.db
# DATABASE_URL=postgresql+asyncpg://voicecare:voicecare@localhost:5432/voicecare
# Optional: Redis for live conversation state (in-process store if unset)
REDIS_URL=

# Security — generate real values outside development:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
JWT_SECRET=dev-only-change-me
ENCRYPTION_KEY=
CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_PER_MINUTE=120

# Development seed data (two fictional demo businesses). Accounts created on first start:
#   platform admin : SEED_ADMIN_EMAIL / SEED_ADMIN_PASSWORD
#   Sunrise Realty : admin@sunrise.local  / SEED_TENANT_PASSWORD
#   CareWell Hosp. : admin@carewell.local / SEED_TENANT_PASSWORD
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@platform.local
SEED_ADMIN_PASSWORD=ChangeMe-Admin-123
SEED_TENANT_PASSWORD=ChangeMe-Tenant-123
